<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject Condition="'$(StartupObject)' == ''">LabEntry</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Ivy connect</AssemblyName>
    <AssemblyTitle>Ivy connect</AssemblyTitle>
    <Product>Ivy connect</Product>
    <Description>Ivy connect 桌面 QQ 单私聊自动回复</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>assets\launcher.ico</ApplicationIcon>
    <ApplicationManifest>IvyConnect.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToPublishDirectory="Always" />
    <None Include="..\docs\LICENSE.dotnet.txt" Link="LICENSE.dotnet.txt" CopyToPublishDirectory="Always" />
    <None Include="..\docs\ThirdPartyNotices.dotnet.txt" Link="ThirdPartyNotices.dotnet.txt" CopyToPublishDirectory="Always" />
    <None Include="..\docs\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="Always" />
    <Compile Include="$(QaEntry)" Condition="'$(QaEntry)' != ''" />
    <EmbeddedResource Include="assets\launcher.ico" LogicalName="QQPrivateApp.LauncherIcon" />
    <EmbeddedResource Include="assets\cover.jpg" LogicalName="QQPrivateApp.DefaultCover" />
  </ItemGroup>
</Project>
